{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "description": "fractaal Pi extension monorepo: agentic QoL extensions published under @fractaal.",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm test --workspace @fractaal/pi-claude-bridge",
    "test:installed": "npm run test:installed --workspaces --if-present",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "npm:@fractaal/pi-ai@0.83.0-fractal.6",
    "@earendil-works/pi-coding-agent": "npm:@fractaal/pi-coding-agent@0.83.0-fractal.6",
    "@sinclair/typebox": "0.34.49",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
